<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_M2a" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_M2a">
    <bpmn:participant id="Participant_1" name="Chuỗi bán lẻ TGDĐ" processRef="Process_M2a" />
    <bpmn:participant id="Participant_2" name="Nhà cung cấp" />
    <bpmn:messageFlow id="MF1" name="Đơn đặt hàng đã phát hành" sourceRef="T4" targetRef="Participant_2" />
    <bpmn:messageFlow id="MF2" name="Xác nhận đơn hàng và ngày giao dự kiến" sourceRef="Participant_2" targetRef="IE1" />
    <bpmn:messageFlow id="MF3" name="Đề nghị lịch giao mới hoặc chia đơn" sourceRef="T5" targetRef="Participant_2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_M2a" isExecutable="false">
    <bpmn:laneSet id="LaneSet_M2a">
      <bpmn:lane id="Lane_1" name="Thu mua">
        <bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E5" name="Đơn đặt hàng đã đủ duyệt">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T4" name="Phát hành đơn đặt hàng">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="IE1" name="Phản hồi nhà cung cấp đã nhận">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="IE1_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G6" name="Nhà cung cấp xác nhận đủ số lượng và đúng hạn giao?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T5" name="Thương lượng lịch giao">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G7">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E6" name="Đơn đã chốt lịch giao">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="E5" targetRef="T4" />
    <bpmn:sequenceFlow id="F2" sourceRef="T4" targetRef="IE1" />
    <bpmn:sequenceFlow id="F3" sourceRef="IE1" targetRef="G6" />
    <bpmn:sequenceFlow id="F4" name="Xác nhận đủ" sourceRef="G6" targetRef="G7" />
    <bpmn:sequenceFlow id="F5" name="Không đáp ứng đủ" sourceRef="G6" targetRef="T5" />
    <bpmn:sequenceFlow id="F6" sourceRef="T5" targetRef="G7" />
    <bpmn:sequenceFlow id="F7" sourceRef="G7" targetRef="E6" />
  </bpmn:process>
