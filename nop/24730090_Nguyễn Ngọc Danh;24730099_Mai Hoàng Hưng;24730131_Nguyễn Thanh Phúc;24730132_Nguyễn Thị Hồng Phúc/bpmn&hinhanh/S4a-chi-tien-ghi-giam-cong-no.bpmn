<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_S4a" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_S4a">
    <bpmn:participant id="Participant_1" name="MWG" processRef="Process_S4a" />
    <bpmn:participant id="Participant_2" name="Ngân hàng" />
    <bpmn:messageFlow id="MF1" name="Lệnh chuyển tiền" sourceRef="T3" targetRef="Participant_2" />
    <bpmn:messageFlow id="MF2" name="Kết quả thực hiện lệnh" sourceRef="Participant_2" targetRef="T3" />
    <bpmn:messageFlow id="MF3" name="Yêu cầu tra soát và lệnh chuyển tiền lập lại" sourceRef="T4" targetRef="Participant_2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_S4a" isExecutable="false">
    <bpmn:laneSet id="LaneSet_S4a">
      <bpmn:lane id="Lane_1" name="Kế toán công nợ">
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E1" name="Đề nghị chi đã được duyệt">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="G1">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T1" name="Hạch toán giảm công nợ">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="Lập lệnh chuyển tiền">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="G2">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T3" name="Chuyển tiền qua ngân hàng">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="Lệnh chuyển tiền thực hiện thành công?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Tra soát và lập lại lệnh">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G4">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Đã chi và ghi giảm công nợ">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="E1" targetRef="G1" />
    <bpmn:sequenceFlow id="F2" sourceRef="G1" targetRef="T1" />
    <bpmn:sequenceFlow id="F3" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F4" sourceRef="T1" targetRef="G2" />
