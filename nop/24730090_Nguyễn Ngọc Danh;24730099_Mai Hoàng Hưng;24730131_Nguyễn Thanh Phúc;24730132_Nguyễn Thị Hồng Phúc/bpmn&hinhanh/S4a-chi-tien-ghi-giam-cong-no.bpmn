    <bpmn:sequenceFlow id="F7" sourceRef="T3" targetRef="G3" />
    <bpmn:sequenceFlow id="F8" name="Thành công" sourceRef="G3" targetRef="G4" />
    <bpmn:sequenceFlow id="F9" name="Thất bại" sourceRef="G3" targetRef="T4" />
    <bpmn:sequenceFlow id="F10" sourceRef="T4" targetRef="G4" />
    <bpmn:sequenceFlow id="F11" sourceRef="G4" targetRef="E2" />
