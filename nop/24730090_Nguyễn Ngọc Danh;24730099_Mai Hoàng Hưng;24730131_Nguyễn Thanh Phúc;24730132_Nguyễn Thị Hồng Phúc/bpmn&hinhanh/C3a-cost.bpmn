<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_C3a" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_C3a">
    <bpmn:participant id="Participant_1" name="Cửa hàng TGDĐ" processRef="Process_C3a" />
    <bpmn:participant id="Participant_2" name="Khách hàng" />
    <bpmn:messageFlow id="MF6" name="Máy và bộ chứng từ" sourceRef="T10" targetRef="Participant_2" />
    <bpmn:messageFlow id="MF7" name="Lịch hẹn giao máy" sourceRef="T11" targetRef="Participant_2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_C3a" isExecutable="false">
    <bpmn:laneSet id="LaneSet_C3a">
      <bpmn:lane id="Lane_1" name="Kho cửa hàng">
        <bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E5" name="Khoản trả trước đã thu xong">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G10" name="Khách nhận máy ngay hay hẹn nhận sau?">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T10" name="Bàn giao máy và hướng dẫn khui hộp kiểm tra&#10;CP 5.208 đ">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T11" name="Hẹn lịch giao và giữ máy theo số IMEI&#10;CP 1.562 đ">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G11">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E6" name="Máy đã bàn giao hoặc đã hẹn giao">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="E5" targetRef="G10" />
    <bpmn:sequenceFlow id="F2" name="Nhận ngay" sourceRef="G10" targetRef="T10" />
    <bpmn:sequenceFlow id="F3" name="Hẹn nhận sau" sourceRef="G10" targetRef="T11" />
    <bpmn:sequenceFlow id="F4" sourceRef="T10" targetRef="G11" />
    <bpmn:sequenceFlow id="F5" sourceRef="T11" targetRef="G11" />
    <bpmn:sequenceFlow id="F6" sourceRef="G11" targetRef="E6" />
  </bpmn:process>
