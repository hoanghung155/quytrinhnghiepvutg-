        <bpmn:flowNodeRef>G10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Kho hàng đổi">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Kế toán hoàn tiền">
        <bpmn:flowNodeRef>G14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E1" name="Khách đã mang máy lỗi và hóa đơn tới cửa hàng">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E1_def" />
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Quét IMEI, tra hóa đơn gốc và kiểm tra hộp cùng phụ kiện">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Đủ hộp và phụ kiện kèm theo?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T2" name="Tính phí thiếu phụ kiện và thiếu hộp vào phiếu tiếp nhận">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T3" name="Lập phiếu tiếp nhận và chuyển máy tới Trung tâm Bảo hành">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="IE1" name="Kết luận thẩm định đã nhận">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="IE1_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G3" name="Trung tâm Bảo hành kết luận lỗi do nhà sản xuất hay do người dùng?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Thông báo từ chối và báo giá sửa chữa có phí">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="Yêu cầu đã bị từ chối, khách đã nhận báo giá sửa chữa có phí">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G4" name="Máy còn trong tháng đầu kể từ ngày mua?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T5" name="Tư vấn phương án đổi mới miễn phí, trả hàng chịu phí hoặc sửa chữa">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T6" name="Tư vấn phương án trả hàng chịu phí lũy tiến hoặc sửa chữa">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G5">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G6" name="Khách chọn phương án nào?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T7" name="Kiểm tra tồn kho hàng đổi cùng model">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G7" name="Còn hàng đổi đúng model tại kho?">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G8" name="Khách chấp nhận đổi sang model tương đương?">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G13">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T8" name="Xuất máy đổi và bàn giao cho khách">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G14">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T9" name="Tính số tiền hoàn sau khi trừ phí và chi trả về phương thức gốc">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T10" name="Chuyển máy đi sửa và theo dõi cam kết 15 ngày">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G9" name="Sửa chữa hoàn tất trong cam kết 15 ngày?">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T11" name="Bàn giao máy đã sửa kèm phiếu bảo hành">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G10">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP1" name="Khép hồ sơ xử lý">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:task id="T14" name="Nhập máy lỗi thu hồi và gom chuyển trả hãng theo kỳ">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E3" name="Yêu cầu đã xử lý xong và máy lỗi đã được thu hồi">
      <bpmn:incoming>F35</bpmn:incoming>
    </bpmn:endEvent>
