        <bpmndi:BPMNLabel><dc:Bounds x="995" y="198" width="130" height="45" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="358" y="174" />
