    <bpmn:task id="t14" name="Xuất hóa đơn, phiếu BH, bàn giao">
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t15" name="Đồng bộ ERP và bên cấp tín dụng">
