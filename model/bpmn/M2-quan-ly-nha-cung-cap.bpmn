<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://uit.edu.vn/bpm/tgdd" id="Defs_M2">
  <bpmn:collaboration id="Collab_M2">
    <bpmn:participant id="Part_M2" name="M2 — Quản lý nhà cung cấp" processRef="M2"/>
  </bpmn:collaboration>
  <bpmn:process id="M2" name="M2 — Quản lý nhà cung cấp" isExecutable="false">
    <bpmn:laneSet id="LaneSet_M2">
      <bpmn:lane id="Lane_0" name="Bộ phận thu mua">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Ban lãnh đạo (phê duyệt)">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Nhà cung cấp (bên ngoài)">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Bộ phận chất lượng / kho">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Hệ thống ERP">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Nhu cầu nhập hàng (M1)
hoặc kỳ đánh giá định kỳ">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G1" name="G1: Loại yêu cầu?">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t1" name="Lập danh sách NCC tiềm năng">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Gửi yêu cầu báo giá (RFQ)">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Gửi hồ sơ năng lực và báo giá">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="G2: Hồ sơ đủ điều kiện dự thầu?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e1" name="Loại NCC khỏi
vòng xét">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t4" name="So sánh và chấm điểm NCC">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="G3: Cần thẩm định năng lực tại chỗ?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t5" name="Thẩm định năng lực tại chỗ">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G4" name="G4: Giá trị hợp đồng vượt hạn mức?">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t6" name="Trình phê duyệt cấp cao">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G5" name="G5: Ban lãnh đạo duyệt?">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e2" name="Không duyệt,
đàm phán lại hoặc dừng">
      <bpmn:incoming>f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t7" name="Đàm phán điều khoản và ký hợp đồng">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Phát hành đơn đặt hàng (PO)">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G6" name="G6: NCC xác nhận PO đúng hạn?">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t9" name="Nhắc và xử lý PO quá hạn xác nhận">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t10" name="Giao hàng theo PO">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t11" name="Kiểm tra chất lượng và số lượng">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G7" name="G7: Lô hàng đạt yêu cầu?">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t12" name="Lập biên bản và trả hàng / khiếu nại">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t13" name="Nhập kho (M3) và ghi nhận công nợ (S4)">
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G8" name="G8: Đến kỳ đánh giá định kỳ NCC?">
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t14" name="Đánh giá NCC (kèm tỷ lệ lỗi từ C4)">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G9" name="G9: Kết quả đánh giá?">
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
      <bpmn:outgoing>f34</bpmn:outgoing>
      <bpmn:outgoing>f35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t15" name="Cảnh báo và yêu cầu khắc phục">
      <bpmn:incoming>f34</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="e3" name="Giữ NCC trong
danh sách">
      <bpmn:incoming>f33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e4" name="Loại NCC khỏi
danh sách">
      <bpmn:incoming>f35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e5" name="Kết thúc chu kỳ
nhập hàng">
      <bpmn:incoming>f30</bpmn:incoming>
    </bpmn:endEvent>
