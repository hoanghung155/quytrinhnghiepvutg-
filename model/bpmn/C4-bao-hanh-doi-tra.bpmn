<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://uit.edu.vn/bpm/tgdd" id="Defs_C4">
  <bpmn:collaboration id="Collab_C4">
    <bpmn:participant id="Part_C4" name="C4 — Bảo hành, đổi trả" processRef="C4"/>
  </bpmn:collaboration>
  <bpmn:process id="C4" name="C4 — Bảo hành, đổi trả" isExecutable="false">
    <bpmn:laneSet id="LaneSet_C4">
      <bpmn:lane id="Lane_0" name="Khách hàng">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="NV tiếp nhận bảo hành">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Kỹ thuật viên / kho">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Quản lý cửa hàng">
        <bpmn:flowNodeRef>G2b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Trung tâm bảo hành (bên ngoài)">
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Hệ thống bảo hành / ERP">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Khách mang máy tới,
nêu yêu cầu">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Tiếp nhận và ghi nhận yêu cầu">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Tra cứu IMEI, ngày mua, hạn bảo hành">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="G1: Máy còn trong hạn bảo hành?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Báo giá sửa chữa thu phí">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1b" name="G1b: Khách đồng ý sửa thu phí?">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e1" name="Chuyển luồng dịch vụ
thu phí (ngoài phạm vi)">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Trả máy,
kết thúc">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G2" name="G2: Bảo hành hay đổi trả?">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2b" name="G2b: Đủ điều kiện đổi trả?">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="Đổi máy hoặc lập chứng từ hoàn tiền">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Kiểm tra ngoại quan và điều kiện">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="G3: Đủ điều kiện bảo hành?">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t6" name="Kiểm tra sơ bộ, phân loại lỗi">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G4" name="G4: Lỗi thuộc loại nào?">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G4b" name="G4b: Khách để lại máy theo dõi?">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t7" name="Xử lý tại chỗ (lỗi phần mềm)">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G5" name="G5: Xử lý tại chỗ thành công?">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t8" name="Lập phiếu tiếp nhận, giao liên cho khách">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="Đóng gói và gửi lên trung tâm bảo hành">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t10" name="Kiểm định và xử lý tại trung tâm">
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G6" name="G6: Kết luận của trung tâm?">
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
      <bpmn:outgoing>f31</bpmn:outgoing>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t11" name="Xuất máy đổi, thu hồi máy lỗi">
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t12" name="Nhận máy về, đối chiếu kết luận">
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G7" name="G7: Máy nhận về đúng và đạt?">
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
      <bpmn:outgoing>f35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t13" name="Thông báo và hẹn khách tới nhận">
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:incoming>f35</bpmn:incoming>
      <bpmn:outgoing>f36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t14" name="Bàn giao, khách kiểm tra và ký nhận">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:incoming>f36</bpmn:incoming>
      <bpmn:outgoing>f37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G8" name="G8: Khách đồng ý với kết quả?">
      <bpmn:incoming>f37</bpmn:incoming>
      <bpmn:outgoing>f38</bpmn:outgoing>
      <bpmn:outgoing>f40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t15" name="Mở khiếu nại, chuyển quản lý xử lý">
      <bpmn:incoming>f38</bpmn:incoming>
      <bpmn:outgoing>f39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t16" name="Ghi nhận và cập nhật thống kê lỗi → M2">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:incoming>f39</bpmn:incoming>
      <bpmn:incoming>f40</bpmn:incoming>
      <bpmn:outgoing>f41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e3" name="Hồ sơ đóng,
dữ liệu lỗi về M2">
      <bpmn:incoming>f41</bpmn:incoming>
    </bpmn:endEvent>
