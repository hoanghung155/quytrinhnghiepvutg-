    <bpmn:task id="t25" name="Điều chỉnh tồn hệ thống">
      <bpmn:incoming>f50</bpmn:incoming>
      <bpmn:outgoing>f51</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t26" name="Tổng hợp cảnh báo tồn ứ và tồn thiếu">
