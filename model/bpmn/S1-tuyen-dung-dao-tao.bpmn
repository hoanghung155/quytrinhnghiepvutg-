  <bpmn:collaboration id="Collab_S1">
    <bpmn:participant id="Part_S1" name="S1 — Tuyển dụng và đào tạo" processRef="S1"/>
  </bpmn:collaboration>
  <bpmn:process id="S1" name="S1 — Tuyển dụng và đào tạo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_S1">
      <bpmn:lane id="Lane_0" name="Bộ phận tuyển dụng">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Quản lý cửa hàng / quản lý vùng">
        <bpmn:flowNodeRef>t0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Ứng viên (bên ngoài)">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Bộ phận đào tạo">
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Hệ thống quản lý nhân sự">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Thiếu nhân sự · mở
cửa hàng mới (M4)">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G1" name="G1: Nguồn nội bộ hay tuyển ngoài?">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t0" name="Điều chuyển nhân sự nội bộ giữa cửa hàng">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t1" name="Xác nhận nhu cầu và chỉ tiêu tuyển">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="G2: Chỉ tiêu vượt định biên đã duyệt?">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t2" name="Trình duyệt bổ sung định biên">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Đăng tuyển và tìm nguồn ứng viên">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Nộp hồ sơ ứng tuyển">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="G3: Hồ sơ đạt sàng lọc?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e1" name="Hồ sơ không đạt,
từ chối">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t5" name="Phỏng vấn vòng 1 — sàng lọc năng lực">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G4" name="G4: Vòng 1 có đạt?">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e2" name="Dừng sau vòng 1">
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t6" name="Phỏng vấn vòng 2 với quản lý cửa hàng">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G5" name="G5: Vòng 2 có đạt?">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e3" name="Đưa vào nguồn
ứng viên dự phòng">
      <bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t7" name="Gửi đề nghị nhận việc">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G6" name="G6: Ứng viên chấp nhận đề nghị?">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e4" name="Ứng viên từ chối,
mở lại nguồn tuyển">
      <bpmn:incoming>f20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t8" name="Hoàn tất hồ sơ, ký hợp đồng thử việc">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="Đào tạo hội nhập và nghiệp vụ quầy">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G7" name="G7: Kiểm tra cuối khóa đạt?">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G8" name="G8: Đã đào tạo lại lần nào chưa?">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e5" name="Không đạt sau khi
đã đào tạo lại">
      <bpmn:incoming>f27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t10" name="Thực tập tại quầy có người kèm cặp">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G9" name="G9: Đánh giá kết thúc thử việc đạt?">
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
      <bpmn:outgoing>f30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e6" name="Không đạt thử việc,
không ký chính thức">
      <bpmn:incoming>f29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t11" name="Ký hợp đồng chính thức, cập nhật hệ thống">
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G10" name="G10: Nhân sự cho cửa hàng mới khai trương?">
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
      <bpmn:outgoing>f34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t12" name="Bố trí theo lịch khai trương (M4)">
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t13" name="Bố trí vào ca làm việc tại cửa hàng">
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e7" name="Nhân viên đủ chuẩn quầy,
sẵn sàng nhận ca">
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:incoming>f35</bpmn:incoming>
    </bpmn:endEvent>
